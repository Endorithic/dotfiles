{
    "rounded_selection": true,
    "hide_mouse": "never",
    "cursor_animation": {
        "enabled": true
    },

    "collaboration_panel": {
        "button": false
    },
    "search": {
        "button": false
    },
    "git_panel": {
        "dock": "left",
    },

    "text_rendering_mode": "grayscale",

    "diagnostics": {
        "inline": {
            "enabled": true,
            "max_severity": "warning"
        }
    },

    "hard_tabs": false,
    "tab_size": 4,
    "indent_guides": {
        "active_line_width": 2,
        "coloring": "indent_aware",
    },

    "languages": {
        "Python": {
            "language_servers": ["ty", "ruff", "!basedpyright"],
            "format_on_save": "on",
            "code_actions_on_format": {
                "source.organizeImports.ruff": true
            }
        }
    },

    "file_types": {
        "C": ["c", "h"],
    },

    "ui_font_size": 20.0,
    "ui_font_weight": 500,
    "ui_font_family": "ZedMono Nerd Font",
    "ui_font_features": {
        "calt": true,
    },

    "buffer_font_size": 19.0,
    "buffer_font_weight": 400.0,
    "buffer_font_family": "ZedMono Nerd Font",
    "buffer_font_features": {
        "calt": true,
    },

    "terminal": {
        "font_family": "ZedMono Nerd Font",
        "cursor_shape": "bar"
    },

    "disable_ai": true,
    "telemetry": {
        "diagnostics": false,
        "metrics": false,
        "anthropic_retention": false,
    },

    "default_open_behavior": "new_window",
    "cli_default_open_behavior": "new_window",

    "colorize_brackets": true,
    "icon_theme": "Catppuccin Mocha",
    "theme": "Catppuccin Mocha"
}
